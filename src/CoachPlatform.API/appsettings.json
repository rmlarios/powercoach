{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=coachplatform;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "TokenSettings": {
    "Secret": "your-super-secret-key-must-be-at-least-32-chars-for-hs256-algorithm",
    "Issuer": "CoachPlatform",
    "Audience": "CoachPlatformAPI",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "RequireDigits": true,
    "RequireNonAlphanumeric": true,
    "RequireUppercase": true
  }
}
